---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Hola Mundo · Astro</title>
  </head>
  <body style="margin:0; min-height:100vh; display:grid; place-items:center; background:#f8fafc; font-family:Inter, system-ui, sans-serif;">
    <main style="text-align:center; padding:2rem 3rem; border-radius:1.25rem; background:#ffffff; box-shadow:0 30px 80px rgba(15, 23, 42, 0.08);">
      <h1 style="font-size:clamp(2.25rem, 4vw, 4rem); margin:0 0 1rem; color:#0f172a;">¡Hola Mundo!</h1>
      <p style="font-size:1.1rem; color:#475569; margin:0 0 1.5rem;">Bienvenido a tu sitio Astro simple.</p>
      <p style="font-size:1rem; color:#334155; margin:0;"><strong>Remote Address:</strong> <span id="remote-address">Cargando...</span></p>
      <p style="font-size:1rem; color:#334155; margin:0;"><strong>Screen Size:</strong> <span id="screen-size">Cargando...</span></p>
      <p style="font-size:1rem; color:#334155; margin:0 0 1.5rem;"><strong>User-Agent:</strong> <span id="user-agent">Cargando...</span></p>
    </main>

    <script>
      function loadRemoteAddress() {
        const host = window.location.host || 'No disponible';
        const protocol = window.location.protocol.replace(':', '') || 'No disponible';
        const path = window.location.pathname || '';
        document.getElementById('remote-address').textContent = `${host}${path}`;
        document.getElementById('remote-address').title = `Protocolo: ${protocol}`;
        document.getElementById('user-agent').textContent = navigator.userAgent || 'No disponible';
        document.getElementById('screen-size').textContent = `${window.screen.width}x${window.screen.height}`;
      }
      loadRemoteAddress();
    </script>
  </body>
</html>
